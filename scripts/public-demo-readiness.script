set now="2026-11-04T00:00:00.000Z"
set future=##class(pbp.Demo.Runtime).IsUnexpired("2026-11-16T04:59:59.000Z",now)
set past=##class(pbp.Demo.Runtime).IsUnexpired("2026-01-01T00:00:00.000Z",now)
set equal=##class(pbp.Demo.Runtime).IsUnexpired(now,now)
set later=##class(pbp.Demo.Runtime).IsUnexpired("2026-11-04T00:00:00.001Z",now)
set earlier=##class(pbp.Demo.Runtime).IsUnexpired("2026-11-03T23:59:59.999Z",now)
set nextyear=##class(pbp.Demo.Runtime).IsUnexpired("2027-01-01T00:00:00.000Z",now)
set result={"cases":6,"provider_calls":0,"native_intakes":0}
do result.%Set("ok",future && 'past && 'equal && later && 'earlier && nextyear,"boolean")
write "PUBLIC_DEMO_READINESS=",result.%ToJSON(),!
halt
